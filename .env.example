# Obtain this value from @BotFather. Never commit the real token.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to administer the catalog.
ADMIN_IDS=
# Kept inside the mounted /data directory by default.
DATABASE_URL=sqlite+aiosqlite:////data/tablegamesbot.db
AUDIT_LOG_PATH=/data/audit/catalog.jsonl
LOG_LEVEL=INFO

